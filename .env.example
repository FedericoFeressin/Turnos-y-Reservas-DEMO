# ─────────────────────────────────────────────────────────────
# Variables de entorno. Copiar a .env.local y completar.
# .env.local no se versiona (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# PostgreSQL (desarrollo local, instalación sin sudo).
# Ajustar usuario y base a los de tu máquina; ver docs/README.md.
DATABASE_URL="postgresql://usuario@localhost:5432/turnos?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generar con: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Contraseña del owner al correr el seed (opcional).
# SEED_OWNER_PASSWORD="estudio-norte"

# Negocio por defecto (desarrollo)
# DEFAULT_BUSINESS_SLUG="estudio-norte"
